# Required environment variables for Meta Tutor
# Copy to .env.local and fill in values — never commit .env.local

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_TRUST_HOST=true

# Backend for the multi-subject hub (/hub, /chess, /latin) — reuses the same Supabase
# project as LessonDraft, isolated via mt_-prefixed tables (supabase-schema-hub.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
