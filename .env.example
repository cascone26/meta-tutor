# Required environment variables for Meta Tutor
# Copy to .env.local and fill in values — never commit .env.local

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_TRUST_HOST=true

# Two-account allowlist (src/lib/access.ts) — only these two emails may sign in at all
# (repo is public; this app rides Jacob's own Claude Max OAuth quota). Jacob is admin and
# sees everything; Cristian is scoped to the Metaphysics-suite pages only. Defaults in
# access.ts already match the real accounts, these overrides are optional.
JACOB_EMAIL=cobo.cascone@gmail.com
CRISTIAN_EMAIL=crisvalldeperas@gmail.com

# Backend for the multi-subject hub (/hub, /chess, /latin) — reuses the same Supabase
# project as LessonDraft, isolated via mt_-prefixed tables (supabase-schema-hub.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
